# Local PostgreSQL + pgvector
POSTGRES_DB=ai
POSTGRES_USER=ai
POSTGRES_PASSWORD=ai
POSTGRES_PORT=5432

# Local vectordb API
VDB_API_PORT=8000
VDB_API_URL=http://localhost:8000
VDB_DEBUG=false

# Keep this aligned with services/vectordb/db/init/001_schema.sql VECTOR dimension.
EMBEDDING_DIM=768

# mock = deterministic local embeddings for plumbing tests
# ollama = local semantic embeddings from an Ollama daemon
# openai = OpenAI/OpenAI-compatible embeddings API
EMBEDDING_BACKEND=mock
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=nomic-embed-text
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SEARCH_CANDIDATES=50

# GitHub MCP. Use a token with the minimum read permissions you need.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Atlassian remote MCP.
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v1/sse
ATLASSIAN_SITE_URL=https://your-domain.atlassian.net/

# Kapa remote MCP. Set either KAPA_REMOTE_MCP_AUTH_HEADER or KAPA_API_TOKEN.
KAPA_REMOTE_MCP_URL=https://gravitee-internal.mcp.kapa.ai
KAPA_API_TOKEN=
KAPA_REMOTE_MCP_AUTH_HEADER=

# Optional config path overrides, useful for tests or non-standard installs.
CODEX_CONFIG=
CURSOR_MCP_CONFIG=
CLAUDE_MCP_CONFIG=
