.local-tooling/
manifests/generated/
reports/
*.bak
*.bak.*
__pycache__/
*.pyc
node_modules/

# macOS
.DS_Store

# NEVER COMMIT: customer map snapshots are local fallback caches generated from
# gravitee-io/cloud-deployments-configuration, which is PRIVATE. This repository is
# PUBLIC, so committing one would publish Gravitee's customer list and their
# infrastructure ids. Ignored under any customers-snapshot*.json name anywhere in
# the repo, so a copy or an --out file with that name is covered too. Generate
# the default one with:
#   cd services/grafana-mcp-adapter && node --env-file=../../.env scripts/refresh-customers.mjs
**/customers-snapshot*.json
